# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=iot_events
POSTGRES_USER=iot
POSTGRES_PASSWORD=change-me

# ── Broker (Projekat 3 koristi samo MQTT) ───────────────────
BROKER_MODE=mqtt
MQTT_TOPIC=iot/readings
MQTT_STORED_TOPIC=iot/stored
MQTT_EVENTS_TOPIC=iot/events
MQTT_QOS=1

# ── Storage (.NET) ──────────────────────────────────────────
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=iot_events;Username=iot;Password=change-me
DATABASE_URL=Host=postgres;Port=5432;Database=iot_events;Username=iot;Password=change-me
STORAGE_BATCH_SIZE=500
STORAGE_FLUSH_INTERVAL_MS=1000
STORAGE_ENABLE_WRITES=true
STORAGE_REPUBLISH=true

# ── Analytics (Node.js) ─────────────────────────────────────
WINDOW_SECONDS=10
ALERT_THRESHOLD=50

# ── MaaS (Python/FastAPI) ───────────────────────────────────
MAAS_URL=http://maas:8000
